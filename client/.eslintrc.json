{
  "env": {
    "browser": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "warn"
  },
  "globals": {
    "APP_CONFIG": "readonly"
  }
}
