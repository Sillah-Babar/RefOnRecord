# ── RefOnRecord — Production Environment Variables ───────────────────────────
# Copy this file to /home/azureuser/refonrecord/.env on the VM
# and fill in real values. NEVER commit the real .env to git.

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string

# SQLite database path (stored in the Flask instance folder by default)
# For production you may switch to PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/refonrecord
DATABASE_URL=sqlite:////home/azureuser/refonrecord/instance/resume_verifier.db

# Comma-separated list of M2M API keys (used by the reminder service and /respond endpoint)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
M2M_API_KEYS=CHANGE_ME_m2m_key_1,CHANGE_ME_m2m_key_2

# ── Reminder service ──────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:5000
M2M_API_KEY=CHANGE_ME_m2m_key_1      # must match one of the keys above
SENDING_API_KEY=YOUR_MAILEROO_API_KEY
FROM_EMAIL=noreply@yourdomain.maileroo.org
REMINDER_DB=/home/azureuser/refonrecord/reminder_service/reminders.db
POLL_INTERVAL=900
REMINDER_DAYS=7
